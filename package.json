{
  "name": "docneedle",
  "version": "0.1.0",
  "description": "Local-first search packs for project docs, notes, and agent memory folders.",
  "type": "module",
  "bin": {
    "docneedle": "./bin/docneedle.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "check": "tsc --noEmit",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --test test/*.test.js",
    "smoke": "npm run build && node ./bin/docneedle.js inspect test/fixtures/agent-workspace --output .tmp/smoke && node ./bin/docneedle.js search test/fixtures/agent-workspace escalation --limit 2 --json && node ./bin/docneedle.js pack test/fixtures/agent-workspace --query onboarding --output .tmp/smoke/onboarding-pack.md",
    "package:smoke": "npm pack --dry-run",
    "package:install-smoke": "npm run build && node scripts/package-install-smoke.js",
    "release:tag-check": "node scripts/check-release-tag.js",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke && npm run package:install-smoke",
    "lint": "npm run check"
  },
  "keywords": [
    "local-first",
    "search",
    "markdown",
    "docs",
    "agents",
    "cli"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/docneedle.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/docneedle/issues"
  },
  "homepage": "https://github.com/rogerchappel/docneedle#readme"
}
